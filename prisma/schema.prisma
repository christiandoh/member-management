generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               Int      @id @default(autoincrement())
  firstName        String
  lastName         String
  phone            String   @unique
  gender           String
  maritalStatus    String
  photo            String?
  role             String   @default("member")
  password         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
